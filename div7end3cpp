#include <iostream>
using namespace std;

int main()
{
    int i = 1, answer = 0;
    int div7 = 0;

    while (i <= 100) {
        if (i % 10 == 3) {
            answer += i;
        }

        if (i % 7 == 0) {
            div7++;
        }

        i++;
    }

    cout << "Sum of all numbers from 1 to 100 that have a 3 in the ones place: " << answer << endl;
    cout << "There are " << div7 << " numbers divisible by 7 from 1 to 100" << endl;

    return 0;
}
